# Flask Configuration (REQUIRED - no defaults)
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Database Configuration
DEV_DATABASE_URL=sqlite:///dev_database.db
DATABASE_URL=sqlite:///production_database.db

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration (optional - for notifications)
# Leave blank to disable email notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=noreply@slowlearning.edu
MAIL_MAX_EMAILS=50

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Optional Settings
DEBUG=False
